# Copy to /etc/threatwatch/threatwatch.env on the server; chown root:root; chmod 600.
# NEVER commit the real file. Values here are examples only.

# Cookie "Secure" flag: keep true behind HTTPS (Tailscale Serve / Cloudflare). Set false only for plain-http local testing.
TW_COOKIE_SECURE=true
# Comma separated hostnames the app will answer to (Host header). Example:
# TW_TRUSTED_HOSTS=threatwatch.your-tailnet.ts.net,watch.thefish.nz
TW_TRUSTED_HOSTS=*

TW_TIMEZONE=Pacific/Auckland
TW_INGEST_INTERVAL_MINUTES=30
TW_BRIEFING_HOUR=7
TW_BRIEFING_MINUTE=0
TW_RETENTION_DAYS=365

# --- Optional AI summarisation (Anthropic). Leave unset to run without AI. ---
# ANTHROPIC_API_KEY=
# TW_AI_MODEL=claude-opus-5-5
# TW_AI_EFFORT=low
# TW_AI_DAILY_BUDGET_USD=2.00
# TW_AI_MAX_REQUESTS_PER_RUN=40
# Pricing used for budget accounting (USD per million tokens) — keep in sync with the model you choose.
# TW_AI_INPUT_USD_PER_MTOK=4.00
# TW_AI_OUTPUT_USD_PER_MTOK=20.00

# --- Optional Web Push (requires HTTPS). Generate with: docker compose run --rm web python -m app.cli vapid
# TW_VAPID_PUBLIC_KEY=
# TW_VAPID_PRIVATE_KEY=
# TW_VAPID_SUBJECT=mailto:you@example.com
