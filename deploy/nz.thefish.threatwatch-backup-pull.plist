<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily copy of Threat Watch server backups to this Mac. Install: see docs/DEPLOYMENT.md ("Off-server backups").
     __HOME__ is replaced at install time. If the Mac is asleep at 09:00, launchd runs it on wake. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>nz.thefish.threatwatch-backup-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/Library/Application Support/ThreatWatch/pull-backups.sh</string>
    <string>tw-vps</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/threatwatch-backup-pull.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/threatwatch-backup-pull.log</string>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
</dict>
</plist>
